---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const progetti = await getCollection('progetti');
  return progetti.map((progetto) => ({
    params: { slug: progetto.id.replace('.md', '') },
    props: { progetto },
  }));
}

const { progetto } = Astro.props;
const { Content } = await render(progetto);
---

<Layout title={`${progetto.data.title} | Naturman Visuals`}>
  
  <article class="progetto-articolo">
    <header class="progetto-header">
      <h1>{progetto.data.title}</h1>
      <p class="data">{progetto.data.date.toLocaleDateString('en-GB')}</p>
    </header>

    <!-- Immagine 16:9 a tutta larghezza -->
    <img src={progetto.data.cover} alt={progetto.data.title} class="cover" />

    <!-- Testo centrato e stretto per leggibilità -->
    <div class="contenuto">
      <Content />
    </div>

    <!-- Griglia della Galleria -->
    {progetto.data.galleria && (
      <div class="galleria-grid">
        {progetto.data.galleria.map((img) => (
          <div class="galleria-item">
            <img src={img} alt="Gallery photo" loading="lazy" class="gallery-img" />
          </div>
        ))}
      </div>
    )}
  </article>

  <!-- LA LIGHTBOX (Dialog) -->
  <dialog id="lightbox" class="fullscreen-dialog">
   <button id="close-lightbox" class="close-btn" aria-label="Back to gallery">
  ✕ Back to gallery
</button>
    
    <img id="lightbox-img" src="" alt="Enlarged image" class="zoomable-img" />
  </dialog>

</Layout>

<style>
  .progetto-header {
    text-align: center;
    margin-bottom: 3rem; 
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .progetto-header h1 {
    font-size: 3.5rem; 
    font-weight: 400; 
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .data {
    color: #888;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    margin: 0 auto 4rem auto;
  }

  .contenuto {
    max-width: 700px; 
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.8;
    color: #444;
  }

  /* Stile per la Griglia */
  .galleria-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 1.5rem;
    margin-top: 4rem;
    width: 100%;
  }

  .galleria-item {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid #222;
    background-color: #1a1a1a;
  }

  .galleria-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
    cursor: zoom-in; /* Mostra la lente di ingrandimento */
  }

  .galleria-item:hover img {
    transform: scale(1.05);
  }

  /* --- STILI DELLA LIGHTBOX --- */
  .fullscreen-dialog::backdrop {
    background: rgba(0, 0, 0, 0.98); 
  }
  /* Modifica il contenitore per permettere lo scroll quando l'immagine è gigante */
  .fullscreen-dialog {
    padding: 0;
    border: none;
    background: transparent;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    overflow: auto; /* Importante: crea le barre di scorrimento se necessario */
  }

  /* Immagine a dimensioni normali (adattata allo schermo) */
  .zoomable-img {
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* La centra perfettamente */
    transition: transform 0.2s ease;
    cursor: zoom-in; /* Cursore a lente d'ingrandimento */
  }

  /* CLASSE ATTIVATA AL CLICK: Dimensione 100% reale! */
  .zoomable-img.is-zoomed {
    max-width: none;
    max-height: none;
    position: static;
    transform: none; /* Toglie il centraggio assoluto */
    margin: 50px auto; /* Margine per non farla toccare i bordi */
    cursor: zoom-out; /* Cursore per rimpicciolire */
  }
  

  .close-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>

<script>
  const dialog = document.getElementById('lightbox');
  const dialogImg = document.getElementById('lightbox-img');
  const closeBtn = document.getElementById('close-lightbox');
  const galleryImages = document.querySelectorAll('.gallery-img');

  // Apri la lightbox
  galleryImages.forEach(img => {
    img.addEventListener('click', () => {
      // Rimuove lo zoom se era rimasto attivo da una foto precedente
      dialogImg.classList.remove('is-zoomed'); 
      dialogImg.src = img.src; 
      dialog.showModal();
    });
  });

  // ZOOM: Clicca sull'immagine per ingrandirla al 100% o rimpicciolirla
  dialogImg.addEventListener('click', (event) => {
    event.stopPropagation(); // Evita che il click chiuda la lightbox
    dialogImg.classList.toggle('is-zoomed');
  });

  // Chiudi con il pulsante "Torna alla galleria"
  closeBtn.addEventListener('click', () => {
    dialog.close();
    dialogImg.src = ''; 
  });

  // Chiudi cliccando sullo sfondo nero
  dialog.addEventListener('click', function (event) {
    if (event.target === dialog) {
      dialog.close();
      dialogImg.src = '';
    }
  });
</script>